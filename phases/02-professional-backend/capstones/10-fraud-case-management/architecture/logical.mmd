%% Fraud case management service: logical architecture
flowchart LR
    subgraph sg0["Capabilities"]
        direction TB
        in["Alert intake<br/>group by customer 48 h"]
        wk["Case work<br/>assign · notes · close"]
        mc["Maker-checker actions"]
        pol["CasePolicy<br/>team / assignee"]
        sla[["SLA monitor"]]
        au["Audit hash chain"]
    end
    subgraph sg1["Data"]
        direction TB
        c[("case · alert · note")]
        a[("action<br/>proposer · approver")]
        l[("audit_log<br/>prev_hash · hash")]
    end
    in --> c
    wk --> pol
    mc --> pol
    wk --> c
    mc --> a
    wk --> au
    mc --> au
    au --> l
    sla --> c
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class pol,au comp
    class c,a,l db
    class sla job
    class in,wk,mc svc
