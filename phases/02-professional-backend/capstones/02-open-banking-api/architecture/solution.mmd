%% Secure open banking accounts API: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        tpp(["TPP apps<br/>(budgeting, lending)"])
        cust(["Bank customers"])
        ops(["Operations / compliance"])
    end
    subgraph sg1["Secure open banking accounts API (system boundary)"]
        direction TB
        api["Open banking API<br/>/account-access-consents · /accounts"]
        db[("Bank data<br/>and consents")]
    end
    subgraph sg2["Platform"]
        direction TB
        kc["Keycloak<br/>TPP clients · customers"]
    end
    subgraph sg3["External systems"]
        direction TB
        cbs[/"Core banking<br/>(source of accounts)"/]
    end
    tpp -->|"client credentials"| kc
    cust -->|"login + approve"| kc
    tpp -->|"JWT + x-consent-id"| api
    cust -->|"authorise / revoke"| api
    api --> db
    ops -->|"access log"| api
    cbs -.->|"accounts, transactions (synthetic here)"| db
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class tpp,cust,ops actor
    class db db
    class cbs ext
    class kc infra
    class api svc
