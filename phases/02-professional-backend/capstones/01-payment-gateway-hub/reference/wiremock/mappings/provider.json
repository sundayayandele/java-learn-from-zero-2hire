{
  "mappings": [
    {
      "request": { "method": "POST", "url": "/transaction/initialize" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": true, "data": { "authorization_url": "https://checkout.example.test/{{randomValue length=10 type='ALPHANUMERIC'}}", "access_code": "local", "reference": "{{jsonPath request.body '$.reference'}}" } },
        "transformers": ["response-template"]
      }
    },
    {
      "request": { "method": "GET", "urlPathPattern": "/transaction/verify/.*" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": true, "data": { "reference": "{{request.pathSegments.[2]}}", "status": "success", "amount": 50000, "currency": "NGN", "id": "local-1" } },
        "transformers": ["response-template"]
      }
    },
    {
      "request": { "method": "POST", "url": "/refund" },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" }, "jsonBody": { "status": true, "data": { "id": "rf_local", "status": "pending" } } }
    }
  ]
}
