%% Payment gateway integration hub: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        merch(["Merchant apps<br/>(client credentials)"])
        cust(["Customers<br/>(pay on provider page)"])
        ops(["Operations"])
    end
    subgraph sg1["Payment gateway integration hub (system boundary)"]
        direction TB
        api["Payment hub API<br/>/payments · /webhooks"]
        db[("Payments database")]
    end
    subgraph sg2["Platform"]
        direction TB
        kc["Keycloak<br/>(identity provider)"]
    end
    subgraph sg3["External systems"]
        direction TB
        pa[/"Provider A"/]
        pb[/"Provider B"/]
    end
    merch -->|"HTTPS + JWT"| api
    cust -.->|"card / transfer"| pa
    api -->|"initialise · verify · refund"| pa
    api -->|"failover"| pb
    pa -.->|"signed webhook"| api
    api --> db
    ops -->|"status, providers"| api
    merch -->|"get token"| kc
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class merch,cust,ops actor
    class db db
    class pa,pb ext
    class kc infra
    class api svc
