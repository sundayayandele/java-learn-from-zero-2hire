%% Merchant onboarding and API key platform: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        dash(["Merchant staff<br/>(dashboard)"])
        srv(["Merchant servers"])
        ops(["Operations"])
    end
    subgraph sg1["Merchant onboarding and API key platform (system boundary)"]
        direction TB
        api["Merchant platform API"]
        db[("Merchants and keys")]
    end
    subgraph sg2["Platform"]
        direction TB
        kc["Keycloak"]
        redis[("Redis<br/>rate limits")]
    end
    subgraph sg3["External systems"]
        direction TB
        ch[/"Companies House"/]
    end
    dash -->|"JWT"| api
    srv -->|"API key / signature"| api
    ops -->|"verify merchants"| api
    api -->|"company profile"| ch
    api --> db
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class dash,srv,ops actor
    class db db
    class ch ext
    class kc infra
    class redis store
    class api svc
