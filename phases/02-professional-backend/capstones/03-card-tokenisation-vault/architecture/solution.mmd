%% Card tokenisation vault: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        cust(["Customer<br/>(enters card)"])
        merch(["Merchants"])
    end
    subgraph sg1["Card tokenisation vault (system boundary)"]
        direction TB
        api["Token vault API<br/>(isolated network)"]
        db[("Encrypted card store")]
    end
    subgraph sg2["Platform"]
        direction TB
        kc["Keycloak<br/>client scopes"]
    end
    subgraph sg3["External systems"]
        direction TB
        checkout[/"Checkout service"/]
        proc[/"Processor / card network"/]
        kms[/"KMS"/]
    end
    cust -->|"card form"| checkout
    checkout -->|"tokenise"| api
    merch -.->|"token only"| checkout
    proc -->|"detokenise (scoped)"| api
    api --> db
    api -->|"wrap / unwrap keys"| kms
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class cust,merch actor
    class db db
    class checkout,proc,kms ext
    class kc infra
    class api svc
