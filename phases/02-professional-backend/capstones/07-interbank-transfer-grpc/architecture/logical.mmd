%% Interbank transfer gRPC service: logical architecture
flowchart LR
    subgraph sg0["Sending bank"]
        direction TB
        ne["Name enquiry<br/>cached 10 min"]
        tx["Transfer<br/>local debit · send"]
        res[["Status resolver<br/>backoff · reverse"]]
    end
    subgraph sg1["Switch"]
        direction TB
        route["Routing by bank code<br/>message log"]
        set["Settlement<br/>net positions stream"]
    end
    subgraph sg2["Receiving bank"]
        direction TB
        cr["Credit<br/>idempotent by session id"]
    end
    subgraph sg3["Data"]
        direction TB
        db[("accounts · transfers<br/>per bank")]
        log[("switch message log")]
    end
    tx --> ne
    tx -->|"FundsTransfer (deadline 10 s)"| route
    route --> cr
    res -->|"TransactionStatus"| route
    tx --> db
    cr --> db
    route --> log
    set --> log
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class db,log db
    class res job
    class ne,tx,route,set,cr svc
