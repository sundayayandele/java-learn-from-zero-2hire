%% AML transaction monitoring: logical architecture
flowchart LR
    subgraph sg0["Loading"]
        direction TB
        stg["Staging (COPY)"]
        tx["Transform<br/>account · txn"]
    end
    subgraph sg1["Detection"]
        direction TB
        sc["Scenarios<br/>structuring · fan-in/out · rapid · cycles"]
        run[["Scenario run<br/>window + thresholds"]]
        al["Alerts<br/>(dedup key)"]
    end
    subgraph sg2["Investigation"]
        direction TB
        case["Cases"]
        dec["Decisions<br/>append-only"]
        eff["Effectiveness<br/>vs labels"]
    end
    subgraph sg3["Data"]
        direction TB
        txn[("txn (millions)<br/>indexed per scenario")]
        alerts[("alert · evidence")]
        cases[("case · decision")]
    end
    stg --> tx
    tx --> txn
    run --> sc
    sc -->|"window functions, recursive CTE"| txn
    sc --> al
    al --> alerts
    case --> alerts
    dec --> cases
    eff --> alerts
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class al,dec,eff comp
    class txn,alerts,cases db
    class run job
    class stg,tx,sc,case svc
