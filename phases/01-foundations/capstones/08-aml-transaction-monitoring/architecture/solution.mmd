%% AML transaction monitoring: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        an(["AML analysts"])
        mlro(["MLRO"])
    end
    subgraph sg1["AML transaction monitoring (system boundary)"]
        direction TB
        api["AML monitoring API"]
        db[("Monitoring DB")]
        job[["Scenario runs"]]
    end
    subgraph sg2["External systems"]
        direction TB
        ibm[/"IBM AMLworld dataset<br/>(CDLA-Sharing-1.0)"/]
        fiu[/"Financial intelligence unit<br/>(STR filing, out of scope)"/]
    end
    ibm -->|"batch load"| api
    job -->|"SQL scenarios"| db
    an -->|"alerts, cases"| api
    mlro -->|"decisions"| api
    api --> db
    mlro -.->|"STR"| fiu
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class an,mlro actor
    class db db
    class ibm,fiu ext
    class job job
    class api svc
