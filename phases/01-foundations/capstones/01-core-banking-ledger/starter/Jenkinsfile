// Jenkins declarative pipeline (multibranch). Agent requirements: Docker, and a JDK 21 tool named "temurin-21"
// (Manage Jenkins > Tools). Credentials: "container-registry" (username/password or token).
// Set REGISTRY (e.g. ghcr.io/<owner>) as a global or folder environment variable. See the Phase 1 CI/CD guide.
pipeline {
    agent any

    tools {
        jdk 'temurin-21'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'core-banking-ledger'
    }

    stages {
        stage('Build and test') {
            steps {
                sh './mvnw -B verify'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/TEST-*.xml'
                }
            }
        }

        stage('Image') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'container-registry',
                        usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh '''
                        echo "$REGISTRY_PASSWORD" | docker login "${REGISTRY%%/*}" -u "$REGISTRY_USER" --password-stdin
                        docker build -t "$REGISTRY/$IMAGE_NAME:$GIT_COMMIT" -t "$REGISTRY/$IMAGE_NAME:latest" .
                        docker push "$REGISTRY/$IMAGE_NAME:$GIT_COMMIT"
                        docker push "$REGISTRY/$IMAGE_NAME:latest"
                    '''
                }
            }
        }
    }

    post {
        cleanup {
            sh 'docker logout "${REGISTRY%%/*}" || true'
        }
    }
}
