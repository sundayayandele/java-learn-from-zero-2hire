%% Core banking ledger: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        cust(["Customers<br/>(via mobile / web)"])
        ops(["Operations / finance"])
    end
    subgraph sg1["Core banking ledger (system boundary)"]
        direction TB
        api["Ledger REST API<br/>/accounts · /transfers · /ledger"]
        db[("Ledger database<br/>PostgreSQL")]
    end
    subgraph sg2["Platform"]
        direction TB
        obs["Prometheus / Grafana<br/>business + JVM metrics"]
    end
    subgraph sg3["External systems"]
        direction TB
        recon[/"Reconciliation<br/>(Capstone 10)"/]
        fx[/"FX rates service<br/>(Capstone 2, stretch)"/]
    end
    cust -->|"HTTPS JSON"| api
    ops -->|"statements, trial balance"| api
    api -->|"ACID transactions"| db
    recon -.->|"ledger extract"| api
    api -.->|"rates for FX journals"| fx
    obs -.->|"scrape"| api
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class cust,ops actor
    class db db
    class recon,fx ext
    class obs infra
    class api svc
