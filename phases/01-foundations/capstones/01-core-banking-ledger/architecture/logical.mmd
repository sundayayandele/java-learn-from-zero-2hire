%% Core banking ledger: logical architecture
flowchart LR
    subgraph sg0["Capabilities"]
        direction TB
        acct["Account management<br/>open · freeze · status"]
        pay["Payments<br/>deposit · transfer · reversal"]
        rules["Rules<br/>fees · daily limits · status"]
        post["Posting engine<br/>balanced double entry"]
        rep["Reporting<br/>statements · trial balance · consistency"]
    end
    subgraph sg1["Data (PostgreSQL)"]
        direction TB
        account[("account<br/>number · kind · balance · version")]
        journal[("journal<br/>unique reference · type · request hash")]
        posting[("posting<br/>immutable · D/C · amount")]
    end
    pay -->|"check"| rules
    pay -->|"post journal"| post
    post --> journal
    post --> posting
    post -->|"update cached balance"| account
    acct --> account
    rep -->|"window functions"| posting
    rep --> account
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class rules comp
    class account,journal,posting db
    class acct,pay,post,rep svc
