%% Consumer complaints triage and SLA service: technical architecture (inside the service)
flowchart TB
    subgraph sg0["Clients"]
        direction TB
        client(["HTTP clients<br/>(apps, partners, ops)"])
    end
    subgraph sg1["Web layer: Spring MVC"]
        direction TB
        c0["ComplaintController"]
        c1["WorkflowController"]
        c2["ReportController"]
        c3["ImportController"]
        advice["ApiExceptionHandler<br/>RFC 9457 Problem Details"]
        valid["Bean Validation<br/>(DTO records)"]
    end
    subgraph sg2["Service layer"]
        direction TB
        s0["IngestionService<br/>(streaming CSV, COPY/batch)"]
        s1["TriageService<br/>(routing rules · SLA clock)"]
        s2["WorkflowService<br/>(state machine, audit)"]
    end
    subgraph sg3["Persistence"]
        direction TB
        r0["ComplaintRepository + FTS queries"]
        r1["BusinessCalendarRepository"]
        r2["Narratives (MongoDB)"]
        flyway["Flyway migrations<br/>ddl-auto=validate"]
    end
    subgraph sg4["Cross-cutting"]
        direction TB
        cfg["@ConfigurationProperties<br/>(validated)"]
        act["Actuator + Micrometer<br/>health · readiness · Prometheus"]
        sched[["Scheduler<br/>SLA breach evaluation"]]
        http["RestClient<br/>timeouts · retries"]
    end
    subgraph sg5["Runtime dependencies"]
        direction TB
        pg[("PostgreSQL 17")]
        mongo[("MongoDB")]
        files[("File / object storage")]
        prom["Prometheus / Grafana"]
    end
    subgraph sg6["External"]
        direction TB
        cfpb[/"CFPB complaint database<br/>(bulk CSV / API)"/]
    end
    client -->|"JSON over HTTPS"| c0
    c0 --> s0
    c1 --> s1
    c2 --> s2
    c3 --> s2
    s0 --> r0
    s1 --> r1
    s2 --> r2
    r0 -->|"JDBC"| pg
    r1 -->|"JDBC"| pg
    r2 -->|"JDBC"| pg
    flyway -->|"migrate on start"| pg
    prom -.->|"scrape /actuator/prometheus"| act
    c0 -.->|"exceptions"| advice
    c0 -.->|"@Valid"| valid
    sched -.->|"invokes"| s0
    s2 -->|"Spring Data MongoDB"| mongo
    s0 -->|"store / read"| files
    s0 -->|"fetch"| http
    http -->|"HTTPS"| cfpb
