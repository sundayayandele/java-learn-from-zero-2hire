%% Consumer complaints triage and SLA service: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        cust(["Customers<br/>(web, branch, contact centre)"])
        agents(["Agents (per team)"])
        compl(["Compliance / management"])
    end
    subgraph sg1["Consumer complaints triage and SLA service (system boundary)"]
        direction TB
        api["Complaints API"]
        pg[("PostgreSQL")]
        mg[("MongoDB (optional)")]
    end
    subgraph sg2["External systems"]
        direction TB
        cfpb[/"CFPB complaint database<br/>(US public domain)"/]
        notify[/"Email / SMS provider<br/>(stretch)"/]
    end
    cust -->|"new complaint"| api
    agents -->|"queues, transitions"| api
    compl -->|"SLA reports"| api
    api --> pg
    api -.->|"narratives"| mg
    cfpb -->|"bulk import"| api
    api -.->|"SLA alerts"| notify
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class cust,agents,compl actor
    class pg db
    class cfpb,notify ext
    class mg store
    class api svc
