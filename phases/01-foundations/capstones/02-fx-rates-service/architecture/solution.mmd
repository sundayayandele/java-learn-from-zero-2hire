%% FX reference rates service: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        apps(["Mobile app / web<br/>(display rates)"])
        fin(["Finance & treasury<br/>(valuation, reporting)"])
        ledger(["Ledger (Capstone 1)<br/>FX journals"])
    end
    subgraph sg1["FX reference rates service (system boundary)"]
        direction TB
        api["FX rates REST API<br/>/rates · /conversions"]
        store[("Rates DB + cache")]
    end
    subgraph sg2["Platform"]
        direction TB
        sch[["Scheduler<br/>(@Scheduled or cloud scheduler)"]]
    end
    subgraph sg3["External systems"]
        direction TB
        ecb[/"ECB reference rates<br/>(ESCB reuse policy)"/]
        ust[/"US Treasury rates<br/>(stretch)"/]
    end
    apps -->|"HTTPS"| api
    fin -->|"HTTPS"| api
    ledger -.->|"HTTPS"| api
    api --> store
    api -->|"daily import"| ecb
    api -.->|"quarterly import"| ust
    sch -.->|"trigger import"| api
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class apps,fin,ledger actor
    class store db
    class ecb,ust ext
    class sch job
    class api svc
