%% FX reference rates service: logical architecture
flowchart LR
    subgraph sg0["Ingestion"]
        direction TB
        dl["Download<br/>(timeouts)"]
        parse["Parse CSV<br/>N/A cells · line numbers"]
        load["Idempotent load<br/>batched upsert"]
        log["Import run log"]
    end
    subgraph sg1["Query"]
        direction TB
        val["Validate codes and dates"]
        res["Resolve publication date<br/>business-day fallback"]
        calc["Cross rate / conversion<br/>10 dp HALF_EVEN, round once"]
    end
    subgraph sg2["Data"]
        direction TB
        rates[("fx_rate<br/>(currency, date) → per EUR")]
        runs[("import_run")]
        cache[("Rate cache<br/>(Caffeine)")]
    end
    dl --> parse
    parse --> load
    load --> rates
    load --> log
    log --> runs
    load -.->|"evict"| cache
    val --> res
    res --> calc
    calc -->|"lookup"| cache
    cache -.->|"miss"| rates
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class parse,log,val comp
    class rates,runs db
    class cache store
    class dl,load,res,calc svc
