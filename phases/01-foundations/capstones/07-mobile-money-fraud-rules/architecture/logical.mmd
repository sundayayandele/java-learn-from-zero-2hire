%% Mobile money fraud rules engine: logical architecture
flowchart LR
    subgraph sg0["Real time"]
        direction TB
        eval["Evaluate transaction"]
        engine["Rule engine<br/>verdict + reasons"]
        state["Account state<br/>sliding windows"]
    end
    subgraph sg1["Batch replay"]
        direction TB
        reader["Streaming reader"]
        part[["Partition by account<br/>N ordered workers"]]
        perf["Rule performance<br/>precision · recall"]
    end
    subgraph sg2["Data"]
        direction TB
        ver[("verdict<br/>(non-Allow only)")]
        cfg[("rule_config<br/>(versioned)")]
        win[("Windows<br/>(memory or Redis)")]
    end
    eval --> engine
    engine --> state
    state --> win
    engine -->|"read"| cfg
    engine --> ver
    reader --> part
    part --> engine
    perf --> ver
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class state,reader comp
    class ver,cfg db
    class part job
    class win store
    class eval,engine,perf svc
