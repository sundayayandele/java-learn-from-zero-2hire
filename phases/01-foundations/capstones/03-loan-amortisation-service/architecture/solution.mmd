%% Loan amortisation and repayment service: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        officer(["Loan officers"])
        cust(["Customers (app)"])
        coll(["Collections team"])
    end
    subgraph sg1["Loan amortisation and repayment service (system boundary)"]
        direction TB
        api["Loan servicing API"]
        db[("Loans DB")]
        job[["Nightly arrears job"]]
    end
    subgraph sg2["External systems"]
        direction TB
        ledger[/"Core ledger (Capstone 1)<br/>disbursement / repayment postings"/]
        wb[/"World Bank WDI<br/>(CC BY 4.0)"/]
    end
    officer -->|"quote, book"| api
    cust -->|"schedule, repay"| api
    coll -->|"arrears buckets"| api
    api --> db
    job -->|"age loans"| db
    api -.->|"post (stretch)"| ledger
    api -.->|"reference rates"| wb
    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef svc fill:#d5e8d4,stroke:#82b366,color:#000
    classDef comp fill:#ffffff,stroke:#666666,color:#000
    classDef db fill:#fff2cc,stroke:#d6b656,color:#000
    classDef store fill:#f5f5f5,stroke:#666666,color:#000
    classDef ext fill:#f8cecc,stroke:#b85450,color:#000,stroke-dasharray: 5 3
    classDef infra fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef job fill:#ffe6cc,stroke:#d79b00,color:#000
    class officer,cust,coll actor
    class db db
    class ledger,wb ext
    class job job
    class api svc
