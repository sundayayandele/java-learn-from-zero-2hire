%% Credit-card default risk scorecard API: solution architecture
flowchart LR
    subgraph sg0["Users and clients"]
        direction TB
        risk(["Credit risk team"])
        cards(["Card operations"])
    end
    subgraph sg1["Credit-card default risk scorecard API (system boundary)"]
        direction TB
        api["Scorecard API"]
        db[("Scores and rules DB")]
    end
    subgraph sg2["External systems"]
        direction TB
        uci[/"UCI Default of Credit Card Clients<br/>(CC BY 4.0)"/]
