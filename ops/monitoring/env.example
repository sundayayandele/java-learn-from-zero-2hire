# /opt/monitoring/.env on the Moodle server (mode 600). setup-monitoring.sh creates it with a random
# Grafana password on the first run; add the optional lines yourself, then re-run the script.

# Generated on the first install. Grafana uses it only when its database is first created.
GRAFANA_ADMIN_PASSWORD=

# Optional: more alert email addresses, comma-separated (admin@itlearning.tech always gets alerts).
ALERT_EMAILS=

# Optional: Telegram alerts. Create a bot with @BotFather, send the bot a message, then read your chat id
# from https://api.telegram.org/bot<token>/getUpdates ("chat":{"id":...}). Set both, or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
