{
  "uid": "itl-learners",
  "title": "ITLearning learners",
  "tags": [
    "itlearning"
  ],
  "timezone": "Africa/Lagos",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
