      "targets": [
        {
          "refId": "A",
          "expr": "sum by (course, cohort, stage) (itl_funnel_cohort_learners)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "learners"
            }
          }
        }
      ],
      "description": "Run itl-funnel on the server for the full per-cohort table with every stage."
