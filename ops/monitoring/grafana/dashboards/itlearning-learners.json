      "id": 1,
      "type": "bargauge",
      "title": "Phase 1 funnel",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "enrolled",
          "expr": "sum(itl_funnel_learners{course=\"JAVA-Z2H-P1\",stage=\"enrolled\"})",
