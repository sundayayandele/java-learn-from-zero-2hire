      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(moodle_http_response_time_seconds_hist_bucket{kind=\"page\"}[5m])))",
