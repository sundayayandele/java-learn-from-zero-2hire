    {
      "id": 13,
      "type": "timeseries",
      "title": "Moodle page load time (real requests, PHP pages)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
